# Copy this file to `.env` (or `.env.local`) for local development.
# `.env*` files are git-ignored and never committed.

# Square access token (Sandbox or Production). Required.
SQUARE_ACCESS_TOKEN=

# "sandbox" or "production" (default: production)
SQUARE_ENVIRONMENT=sandbox

# Square location the app orders against.
SQUARE_LOCATION_ID=

# PIN that unlocks the /admin screen. Required for admin access.
ADMIN_PIN=1234

# Optional: only needed if you receive Square webhooks locally.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=

# Optional: override the Square API base URL (normally derived from SQUARE_ENVIRONMENT).
# SQUARE_API_BASE=https://connect.squareupsandbox.com
